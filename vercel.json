{
  "redirects": [
    {
      "source": "/tt",
      "destination": "https://tiktok.me/moviki.oficial?ref=w61290063&message=%E2%80%8C%EF%BB%BF%E2%80%8C%EF%BB%BF%E2%80%8B%EF%BB%BF%E2%80%8C%E2%80%8D%E2%80%8B%EF%BB%BF%E2%80%8B%E2%80%8C%E2%80%8B%EF%BB%BF%E2%80%8B%E2%80%8D%E2%80%8B%EF%BB%BF%E2%80%8D%E2%80%8C%E2%80%8B%EF%BB%BF%E2%80%8B%E2%80%8B%E2%80%8B%EF%BB%BF%E2%80%8B%E2%80%8B%E2%80%8B%EF%BB%BF%E2%80%8C%E2%80%8D%E2%80%8B%EF%BB%BF%E2%80%8B%EF%BB%BFOi%2C%20Moviki%21%20Quero%20conhecer.",
      "permanent": false
    },
    {
      "source": "/ig",
      "destination": "https://ig.me/m/moviki.oficial?ref=qr",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ramos.js",
      "destination": "https://app.moviki.com.br/ramos.js"
    },
    {
      "source": "/pp/:slug",
      "destination": "/pp.html"
    },
    {
      "source": "/p/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Iframely|Embedly).*"
        },
        {
          "type": "query",
          "key": "ramo"
        }
      ],
      "destination": "/api/aovivo-og?p=:slug&t=p"
    },
    {
      "source": "/c/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Iframely|Embedly).*"
        },
        {
          "type": "query",
          "key": "ramo"
        }
      ],
      "destination": "/api/aovivo-og?p=:slug&t=c"
    },
    {
      "source": "/p/:slug",
      "destination": "/p.html"
    },
    {
      "source": "/c/:slug",
      "destination": "/p.html"
    },
    {
      "source": "/f/:slug",
      "destination": "/f.html"
    },
    {
      "source": "/fc/:slug",
      "destination": "/f.html"
    },
    {
      "source": "/v/:slug",
      "destination": "/v.html"
    },
    {
      "source": "/live/:slug",
      "destination": "/api/og?slug=:slug&live=1"
    },
    {
      "source": "/aovivo",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Iframely|Embedly).*"
        }
      ],
      "destination": "/api/aovivo-og"
    },
    {
      "source": "/aovivo",
      "destination": "/aovivo.html"
    },
    {
      "source": "/regras-da-live",
      "destination": "/regras-da-live.html"
    },
    {
      "source": "/criadores",
      "destination": "/criadores.html"
    },
    {
      "source": "/sitemap-negocios.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/live-shop",
      "destination": "/live-shop.html"
    },
    {
      "source": "/guia/taxas-live-shop",
      "destination": "/guia-taxas-live-shop.html"
    },
    {
      "source": "/fundador",
      "destination": "/fundador.html"
    },
    {
      "source": "/live-shop/clientela",
      "destination": "/clientela.html"
    },
    {
      "source": "/live-shop/moda",
      "destination": "/live-shop-ramos/moda.html"
    },
    {
      "source": "/live-shop/cosmeticos",
      "destination": "/live-shop-ramos/cosmeticos.html"
    },
    {
      "source": "/live-shop/perfumaria",
      "destination": "/live-shop-ramos/perfumaria.html"
    },
    {
      "source": "/live-shop/semijoias",
      "destination": "/live-shop-ramos/semijoias.html"
    },
    {
      "source": "/live-shop/bijuteria",
      "destination": "/live-shop-ramos/bijuteria.html"
    },
    {
      "source": "/live-shop/calcados",
      "destination": "/live-shop-ramos/calcados.html"
    },
    {
      "source": "/live-shop/suplementos",
      "destination": "/live-shop-ramos/suplementos.html"
    },
    {
      "source": "/live-shop/pet",
      "destination": "/live-shop-ramos/pet.html"
    },
    {
      "source": "/live-shop/farmacia",
      "destination": "/live-shop-ramos/farmacia.html"
    },
    {
      "source": "/live-shop/otica",
      "destination": "/live-shop-ramos/otica.html"
    },
    {
      "source": "/live-shop/lingerie",
      "destination": "/live-shop-ramos/lingerie.html"
    },
    {
      "source": "/live-shop/moda-infantil",
      "destination": "/live-shop-ramos/moda-infantil.html"
    },
    {
      "source": "/vip/:acao/:t",
      "destination": "/vip.html"
    },
    {
      "source": "/pedido/:ref",
      "destination": "/pedido.html"
    },
    {
      "source": "/entregadores",
      "destination": "/entregadores.html"
    },
    {
      "source": "/entregadores/sair/:t",
      "destination": "/entregadores.html"
    },
    {
      "source": "/:slug([A-Za-z0-9_-]{3,40})",
      "destination": "/api/og?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/live-shop-ramos/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/sw-vip.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "{404,live}.html"
    },
    "api/aovivo-og.js": {
      "includeFiles": "aovivo.html"
    }
  }
}
